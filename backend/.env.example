# =====================================================
# Hogaru — Configuración de Variables de Entorno (Plantilla)
# Copiá este archivo como .env en backend/ y ajustá según tu entorno.
# =====================================================

# Base de datos MySQL / MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hogaru

# Seguridad y Autenticación JWT
JWT_SECRET=hogaru-secreto-super-seguro-cambiar-en-produccion
JWT_HORAS=12

# Reglas de Negocio
COMISION_PLATAFORMA=0.10
MOMENTO_PAGO=flexible

# CORS (Permitir frontend)
CORS_ORIGINS=*
